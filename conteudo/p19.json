[`<h2>Everywhere</h2>Esse é um joguinho que funciona em computadores com windows.<br>\nEle se baseia no formato hta que é basicamente como html.\n`,
`<h2>Simples Janela</h2>A base do jogo é o arquivo código-executavel.<pre><code class="language-html">&lt;hta:application border="thin" maximizebutton="no" minimizebutton="no" scroll="no"><br>\n&lt;html><br>\n&lt;title>Everywhere&lt;/title><br>\n&lt;meta name="viewport" content="width=device-width"><br>\n&lt;body style="background-color:#48b2e7; margin:0px;">&lt;/body><br>\n&lt;script><br>\nwindow.resizeTo(700,700); //tamanho da janela do jogo na tela do usuario<br>\nwindow.moveTo(10,10); //posicao da janela do jogo na tela do usuario<br>\n&lt;/script><br>\n&lt;/html></code></pre>\n`,
`<h2>As imagens do Jogo</h2>Extraia a pasta <a href=res/19/imagens.zip>imagens</a>\n`,
`<h2>Terry se Movendo na Tela</h2><pre><code class="language-html">&lt;hta:application border="thin" maximizebutton="no" minimizebutton="no" scroll="no"><br>\n&lt;html><br>\n&lt;title>Everywhere&lt;/title><br>\n&lt;meta name="viewport" content="width=device-width"><br>\n&lt;body style="background-image:url('imagens/background.png'); background-color:#48b2e7; margin:0px;" onkeydown="movimento(event.keyCode);" onkeyup="solta(event.keyCode);">&lt;/body><br>\n&lt;script><br>\nwindow.resizeTo(700,700); //tamanho da janela do jogo na tela do usuario<br>\nwindow.moveTo(10,10); //posicao da janela do jogo na tela do usuario<br>\n<br>\n//coordenadas da posicao inicial<br>\nterry=[400,400];<br>\n<br>\n// durante o jogo a &lt;img> do terry (left,top) muda de posicao<br>\ndocument.body.innerHTML+="&lt;img src=imagens/terry.png id=terry style='width:128px; height:128px; position:absolute; top:"+terry[0]+"px; left:"+terry[1]+"px;'>";<br>\n<br>\n//leftPressed upPressed rightPressed downPressed (tecla pressionada)<br>\nkeys=[false,false,false,false];<br>\n<br>\nfunction gameLoop(){<br>\n	//verifica se precisa atualizar posicao do terry na tela<br>\n	if(keys[0]&&terry[1]>140)terry[1]-=10;<br>\n	if(keys[1]&&terry[0]>110)terry[0]-=10;<br>\n	if(keys[2]&&terry[1]&lt;710)terry[1]+=10;<br>\n	if(keys[3]&&terry[0]&lt;640)terry[0]+=10;<br>\n<br>\n	//redesenha o terry na tela<br>\n	document.getElementById('terry').style.top=parseInt(terry[0]-128)+"px";<br>\n	document.getElementById('terry').style.left=parseInt(terry[1]-148)+"px";<br>\n<br>\n	setTimeout("gameLoop()",10); //re-chama/re-invoca a funcao gameLoop depois de um 'delay' de 10 milissegundos<br>\n}<br>\ngameLoop(); //executa a funcao gameloop pela primeira vez<br>\n<br>\nfunction movimento(k){<br>\n	if(k==37)keys[0]=true; //apertou left<br>\n	if(k==38)keys[1]=true; //apertou up<br>\n	if(k==39)keys[2]=true; //apertou right<br>\n	if(k==40)keys[3]=true; //apertou down<br>\n}<br>\nfunction solta(k){<br>\n	if(k==37)keys[0]=false; //soltou left<br>\n	if(k==38)keys[1]=false; //soltou up<br>\n	if(k==39)keys[2]=false; //soltou right<br>\n	if(k==40)keys[3]=false; //soltou down<br>\n}<br>\n&lt;/script><br>\n&lt;/html></code></pre>\n`,
`<h2>Criação e ciclo de vida do oponente</h2><pre><code class="language-html">&lt;hta:application border="thin" maximizebutton="no" minimizebutton="no" scroll="no"><br>\n&lt;html><br>\n&lt;title>Everywhere&lt;/title><br>\n&lt;meta name="viewport" content="width=device-width"><br>\n&lt;body style="background-image:url('imagens/background.png'); background-color:#48b2e7; margin:0px;" onkeydown="movimento(event.keyCode);" onkeyup="solta(event.keyCode);">&lt;/body><br>\n&lt;script><br>\nwindow.resizeTo(700,700); //tamanho da janela do jogo na tela do usuario<br>\nwindow.moveTo(10,10); //posicao da janela do jogo na tela do usuario<br>\n<br>\ndocument.body.innerHTML+="&lt;img id=oponent style='position:absolute;'>";<br>\n<br>\n//coordenadas da posicao inicial<br>\nterry=[400,400];<br>\n<br>\n// durante o jogo a &lt;img> do terry (left,top) muda de posicao<br>\ndocument.body.innerHTML+="&lt;img src=imagens/terry.png id=terry style='width:128px; height:128px; position:absolute; top:"+terry[0]+"px; left:"+terry[1]+"px;'>";<br>\n<br>\n//leftPressed upPressed rightPressed downPressed (tecla pressionada)<br>\nkeys=[false,false,false,false];<br>\n<br>\nfunction initOponent(){<br>\n	figura=["bee","block","fish","fish2","saw"][parseInt(Math.random()*5)]; //aparencia aleatoria<br>\n	sentido=["cima","baixo","esquerda","direita"][parseInt(Math.random()*4)]; //direcao aleatoria<br>\n	tamanho=60+parseInt(Math.random()*70); //tamanho aleatorio<br>\n<br>\n	//posicao aleatoria do oponente<br>\n	if(sentido=="cima")posicao=[0-parseInt(Math.random()*200),50+parseInt(Math.random()*600)];<br>\n	if(sentido=="direita")posicao=[50+parseInt(Math.random()*600),700+parseInt(Math.random()*200)];<br>\n	if(sentido=="baixo")posicao=[700+parseInt(Math.random()*200),50+parseInt(Math.random()*600)];<br>\n	if(sentido=="esquerda")posicao=[50+parseInt(Math.random()*600),0-parseInt(Math.random()*200)];<br>\n<br>\n	//velocidade aleatoria do oponente<br>\n	if(sentido=="cima")deslocamento=[3+parseInt(Math.random()*3),0];<br>\n	if(sentido=="direita")deslocamento=[0,-3-parseInt(Math.random()*3)];<br>\n	if(sentido=="baixo")deslocamento=[-3-parseInt(Math.random()*3),0];<br>\n	if(sentido=="esquerda")deslocamento=[0,3+parseInt(Math.random()*3)];<br>\n<br>\n	//adiciona oponente na DOM (Document Object Model)<br>\n	document.getElementById('oponent').src="imagens/"+sentido+"/"+figura+".png";<br>\n	document.getElementById('oponent').style.width=tamanho+"px";<br>\n}<br>\ninitOponent();<br>\n<br>\nfunction gameLoop(){<br>\n<br>\n	//se o oponente tá longe do fim da tela entao gera 'outro' oponente aleatorio<br>\n	if(posicao[0]&lt;-200||posicao[0]>900||posicao[1]&lt;-200||posicao[1]>900)initOponent();<br>\n<br>\n	//calcula posicao do oponente na tela<br>\n	posicao[0]+=deslocamento[0];<br>\n	posicao[1]+=deslocamento[1];<br>\n<br>\n	//atualiza exibicao do oponente<br>\n	document.getElementById('oponent').style.top=parseInt(posicao[0]-tamanho/2)+"px";<br>\n	document.getElementById('oponent').style.left=parseInt(posicao[1]-tamanho/2)+"px";<br>\n<br>\n	//colision detect<br>\n	colisao=false;<br>\n	if(<br>\n		posicao[0]-terry[0]>-159&& //cima<br>\n		posicao[0]-terry[0]&lt;tamanho/2&& //baixo<br>\n		posicao[1]-terry[1]>-165&& //esquerda<br>\n		posicao[1]-terry[1]&lt;(tamanho/2)-51 //direita<br>\n	)colisao=true;<br>\n<br>\n	//verifica se precisa atualizar posicao do terry na tela<br>\n	if(keys[0]&&terry[1]>140)terry[1]-=10;<br>\n	if(keys[1]&&terry[0]>110)terry[0]-=10;<br>\n	if(keys[2]&&terry[1]&lt;710)terry[1]+=10;<br>\n	if(keys[3]&&terry[0]&lt;640)terry[0]+=10;<br>\n<br>\n	//redesenha o terry na tela<br>\n	document.getElementById('terry').style.top=parseInt(terry[0]-128)+"px";<br>\n	document.getElementById('terry').style.left=parseInt(terry[1]-148)+"px";<br>\n<br>\n	if(colisao)location.reload(); //gameover<br>\n	else setTimeout("gameLoop()",10); //chama/invoca a funcao gameLoop depois de um 'delay' de 10 milissegundos<br>\n}<br>\ngameLoop();<br>\nfunction movimento(k){<br>\n	if(k==37)keys[0]=true; //apertou left<br>\n	if(k==38)keys[1]=true; //apertou up<br>\n	if(k==39)keys[2]=true; //apertou right<br>\n	if(k==40)keys[3]=true; //apertou down<br>\n}<br>\nfunction solta(k){<br>\n	if(k==37)keys[0]=false; //soltou left<br>\n	if(k==38)keys[1]=false; //soltou up<br>\n	if(k==39)keys[2]=false; //soltou right<br>\n	if(k==40)keys[3]=false; //soltou down<br>\n}<br>\n&lt;/script><br>\n&lt;/html></code></pre>\n`,
`<h2>Arrays de Atributos dos Oponentes</h2><pre><code class="language-javascript">QUANTOS=6; //quantidade de oponenetes<br><br>\n\n// essas &lt;img> vao conter os oponentes<br>\nfor(i=0;i&lt;QUANTOS;i++)document.body.innerHTML+="&lt;img id=oponent"+i+" style='position:absolute;'>";<br><br>\n\nfigura=[]; //array de imagens dos oponentes<br>\nsentido=[]; //array das direcoes em que os oponentes se movem<br>\ntamanho=[]; //array com os tamanhos dos oponentes na tela<br>\nposicao=[]; //array com coordenadas de cada oponente<br>\ndeslocamento=[]; //array das velocidades do deslocamento dos oponentes<br>\nfunction initOponent(i){ //inicializa oponente<br>\n	figura[i]=["bee","block","fish","fish2","saw"][parseInt(Math.random()*5)]; //aparencia aleatoria<br>\n	sentido[i]=["cima","baixo","esquerda","direita"][parseInt(Math.random()*4)]; //direcao aleatoria<br>\n	tamanho[i]=60+parseInt(Math.random()*70); //tamanho aleatorio<br>\n<br>\n	//posicao aleatoria do oponente<br>\n	if(sentido[i]=="cima")posicao[i]=[0-parseInt(Math.random()*200),50+parseInt(Math.random()*600)];<br>\n	if(sentido[i]=="direita")posicao[i]=[50+parseInt(Math.random()*600),700+parseInt(Math.random()*200)];<br>\n	if(sentido[i]=="baixo")posicao[i]=[700+parseInt(Math.random()*200),50+parseInt(Math.random()*600)];<br>\n	if(sentido[i]=="esquerda")posicao[i]=[50+parseInt(Math.random()*600),0-parseInt(Math.random()*200)];<br>\n<br>\n	//velocidade aleatoria do oponente<br>\n	if(sentido[i]=="cima")deslocamento[i]=[3+parseInt(Math.random()*3),0];<br>\n	if(sentido[i]=="direita")deslocamento[i]=[0,-3-parseInt(Math.random()*3)];<br>\n	if(sentido[i]=="baixo")deslocamento[i]=[-3-parseInt(Math.random()*3),0];<br>\n	if(sentido[i]=="esquerda")deslocamento[i]=[0,3+parseInt(Math.random()*3)];<br>\n<br>\n	//adiciona oponente na DOM (Document Object Model)<br>\n	document.getElementById('oponent'+i).src="imagens/"+sentido[i]+"/"+figura[i]+".png";<br>\n	document.getElementById('oponent'+i).style.width=tamanho[i]+"px";<br>\n}<br>\nfor(i=0;i&lt;QUANTOS;i++)initOponent(i); //inicializa todos os oponentes iniciais<br>\nfunction gameLoop(){<br>\n	colisao=false;<br>\n	for(i=0;i&lt;QUANTOS;i++){ //loop de 'gerenciamento' dos 'oponentes'<br>\n		//se o oponente tá longe do fim da tela entao gera 'outro' oponente aleatorio<br>\n		if(posicao[i][0]&lt;-200||posicao[i][0]>900||posicao[i][1]&lt;-200||posicao[i][1]>900)initOponent(i);<br>\n<br>\n		//calcula posicao do oponente na tela<br>\n		posicao[i][0]+=deslocamento[i][0];<br>\n		posicao[i][1]+=deslocamento[i][1];<br>\n<br>\n		//atualiza exibicao do oponente<br>\n		document.getElementById('oponent'+i).style.top=parseInt(posicao[i][0]-tamanho[i]/2)+"px";<br>\n		document.getElementById('oponent'+i).style.left=parseInt(posicao[i][1]-tamanho[i]/2)+"px";<br>\n<br>\n		//colision detect<br>\n		if(<br>\n			posicao[i][0]-terry[0]>-159&& //cima<br>\n			posicao[i][0]-terry[0]&lt;tamanho[i]/2&& //baixo<br>\n			posicao[i][1]-terry[1]>-165&& //esquerda<br>\n			posicao[i][1]-terry[1]&lt;(tamanho[i]/2)-51 //direita<br>\n		)colisao=true;<br>\n	}<br>\n<br>\n	//verifica se precisa atualizar posicao do terry na tela<br>\n	if(keys[0]&&terry[1]>140)terry[1]-=10;<br>\n	if(keys[1]&&terry[0]>110)terry[0]-=10;<br>\n	if(keys[2]&&terry[1]&lt;710)terry[1]+=10;<br>\n	if(keys[3]&&terry[0]&lt;640)terry[0]+=10;<br>\n<br>\n	//redesenha o terry na tela<br>\n	document.getElementById('terry').style.top=parseInt(terry[0]-128)+"px";<br>\n	document.getElementById('terry').style.left=parseInt(terry[1]-148)+"px";<br>\n<br>\n	if(colisao)location.reload(); //gameover<br>\n	else setTimeout("gameLoop()",10); //chama/invoca a funcao gameLoop depois de um 'delay' de 10 milissegundos<br>\n}<br>\ngameLoop();</code></pre>\n`,
`<h2>Experimente o Game</h2>Baixe o jogo <a href=res/19/Everywhere.zip>Everywhere</a> e diverta-se por alguns minutos.\n`]